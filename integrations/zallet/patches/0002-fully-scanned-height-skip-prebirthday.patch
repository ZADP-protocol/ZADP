+    /// Synthetic `scan_queue` fixture only — production code never mutates via raw SQL.
+    fn replace_scan_queue_fixture(conn: &Connection, rows: &[(u32, u32, ScanPriority)]) {
+        conn.execute("DELETE FROM scan_queue", []).unwrap();
+        for &(start, end, priority) in rows {
+            conn.execute(
+                "INSERT INTO scan_queue (block_range_start, block_range_end, priority)
+                 VALUES (:start, :end, :priority)",
+                named_params![
+                    ":start": start,
+                    ":end": end,
+                    ":priority": priority_code(&priority),
+                ],
+            )
+            .unwrap();
+        }
+    }
+
+    fn birthday_wallet() -> TestState<BlockCache, TestDb, LocalNetwork> {
+        TestBuilder::new()
+            .with_data_store_factory(TestDbFactory::default())
+            .with_block_cache(BlockCache::new())
+            .with_account_from_sapling_activation(BlockHash([0; 32]))
+            .build()
+    }
+
+    #[test]
+    fn fully_scanned_height_ignores_stale_prebirthday_scanned() {
+        let st = birthday_wallet();
+        let birthday = u32::from(st.sapling_activation_height());
+        let tip_end = birthday + 500;
+
+        // Old no-account Scanned below birthday, Ignored gap, then genuine Scanned covering
+        // birthday through a recent tip — the pre-birthday leftover must not win selection.
+        replace_scan_queue_fixture(
+            st.wallet().conn(),
+            &[
+                (8_367, 21_354, ScanPriority::Scanned),
+                (21_354, birthday, ScanPriority::Ignored),
+                (birthday, tip_end, ScanPriority::Scanned),
+            ],
+        );
+
+        assert_eq!(
+            fully_scanned_height(st.wallet().conn()).unwrap(),
+            Some(BlockHeight::from_u32(tip_end - 1))
+        );
+    }
+
+    #[test]
+    fn fully_scanned_height_none_when_only_prebirthday_scanned() {
+        let st = birthday_wallet();
+        let birthday = u32::from(st.sapling_activation_height());
+
+        replace_scan_queue_fixture(
+            st.wallet().conn(),
+            &[
+                (8_367, 21_354, ScanPriority::Scanned),
+                (21_354, birthday + 200, ScanPriority::Historic),
+            ],
+        );
+
+        assert_eq!(fully_scanned_height(st.wallet().conn()).unwrap(), None);
+    }
+
+    #[test]
+    fn fully_scanned_height_none_when_first_relevant_starts_after_birthday() {
+        let st = birthday_wallet();
+        let birthday = u32::from(st.sapling_activation_height());
+
+        replace_scan_queue_fixture(
+            st.wallet().conn(),
+            &[
+                (8_367, birthday, ScanPriority::Scanned),
+                (birthday + 10, birthday + 200, ScanPriority::Scanned),
+            ],
+        );
+
+        assert_eq!(fully_scanned_height(st.wallet().conn()).unwrap(), None);
+    }
+
+    #[test]
+    fn fully_scanned_height_stops_at_containing_range_with_later_gap() {
+        let st = birthday_wallet();
+        let birthday = u32::from(st.sapling_activation_height());
+        let mid = birthday + 50;
+        let tip_end = birthday + 200;
+
+        // Contiguous Scanned covering birthday ends mid-way; later Scanned after a gap must not
+        // inflate progress past the gap.
+        replace_scan_queue_fixture(
+            st.wallet().conn(),
+            &[
+                (birthday - 10, mid, ScanPriority::Scanned),
+                (mid, mid + 20, ScanPriority::Historic),
+                (mid + 20, tip_end, ScanPriority::Scanned),
+            ],
+        );
+
+        assert_eq!(
+            fully_scanned_height(st.wallet().conn()).unwrap(),
+            Some(BlockHeight::from_u32(mid - 1))
+        );
+    }
+
+    #[test]
+    fn fully_scanned_height_excludes_scanned_ending_at_birthday() {
+        let st = birthday_wallet();
+        let birthday = u32::from(st.sapling_activation_height());
+
+        // End-exclusive range ending at birthday covers only up to birthday-1, so birthday itself
+        // is unscanned — must not report a fully-scanned height from that leftover alone.
+        replace_scan_queue_fixture(
+            st.wallet().conn(),
+            &[
+                (1_000, birthday, ScanPriority::Scanned),
+                (birthday + 1, birthday + 100, ScanPriority::Scanned),
+            ],
+        );
+
+        assert_eq!(fully_scanned_height(st.wallet().conn()).unwrap(), None);
+    }
+
+    #[test]
+    fn fully_scanned_height_none_without_accounts() {
+        let st = TestBuilder::new()
+            .with_data_store_factory(TestDbFactory::default())
+            .build();
+
+        replace_scan_queue_fixture(
+            st.wallet().conn(),
+            &[(1_000, 50_000, ScanPriority::Scanned)],
+        );
+
+        assert_eq!(fully_scanned_height(st.wallet().conn()).unwrap(), None);
+    }
