+    /// Regression: a no-scanned-block wallet with shard metadata and birthday above the
+    /// supplied tip must not construct inverted `ChainTip`/`Historic` ranges (previously
+    /// panicked in `ScanRange::from_parts`). The scan queue stays intact until tip catches up.
+    fn update_chain_tip_skips_when_tip_below_birthday<T: ShieldedPoolTester>() {
+        // Use a non-zero birthday offset because Sapling and NU5 are activated at the same height.
+        let (mut st, _, birthday, _sap_active) =
+            test_with_nu5_birthday_offset::<T>(76, 1000, BlockHash([0; 32]), true);
+        let b = birthday.height();
+
+        // Lagging tip before any tip-above-birthday update: must not panic, queue unchanged.
+        let before_any_tip_advance = suggest_scan_ranges(st.wallet().conn(), Ignored).unwrap();
+        let lagging_tip = b - 1000;
+        st.wallet_mut().update_chain_tip(lagging_tip).unwrap();
+        assert_eq!(
+            suggest_scan_ranges(st.wallet().conn(), Ignored).unwrap(),
+            before_any_tip_advance,
+            "tip below birthday must leave the scan queue intact"
+        );
+
+        // Control: normal catch-up once the tip is at/above the birthday.
+        let tip_height = b + 500;
+        st.wallet_mut().update_chain_tip(tip_height).unwrap();
+        let chain_end = u32::from(tip_height + 1);
+        let after_catch_up = suggest_scan_ranges(st.wallet().conn(), Ignored).unwrap();
+        assert!(
+            after_catch_up.iter().any(|r| {
+                r.priority() == ChainTip && u32::from(r.block_range().end) == chain_end
+            }),
+            "catch-up must schedule ChainTip through the new tip; got {after_catch_up:?}"
+        );
+
+        // A subsequent lagging tip must still refuse to rewrite the healthy queue.
+        let healthy = after_catch_up.clone();
+        st.wallet_mut().update_chain_tip(lagging_tip).unwrap();
+        assert_eq!(
+            suggest_scan_ranges(st.wallet().conn(), Ignored).unwrap(),
+            healthy,
+            "lagging tip after catch-up must not shrink or invert the scan queue"
+        );
+    }
